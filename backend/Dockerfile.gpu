# GPU inference image (Phase AI-1).
#
# Extends the standard backend image with the CV runtime (numpy + onnxruntime).
# By default this installs the CPU wheel of onnxruntime so the image builds and
# runs anywhere. On a real GPU host, build with:
#
#   docker build -f backend/Dockerfile.gpu \
#       --build-arg ORT_PACKAGE=onnxruntime-gpu ./backend
#
# and run the container with the NVIDIA runtime (nvidia-container-toolkit). The
# CUDA/cuDNN userspace libs come from onnxruntime-gpu's wheel; the host only needs
# a recent NVIDIA driver. Keep this image separate from the VMS core so heavy CV
# deps never touch the recording/playback path.
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
        ffmpeg \
        curl \
        libpq5 \
        libgl1 \
        libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Base app deps first (cached), then the CV runtime.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

ARG ORT_PACKAGE=onnxruntime
RUN pip install --no-cache-dir "numpy>=1.26,<2.3" "${ORT_PACKAGE}>=1.17"

COPY . .

# The continuous inference worker (object detection). Overridable in compose.
CMD ["python", "manage.py", "run_inference"]
