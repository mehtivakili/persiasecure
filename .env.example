# ===== PersianSecure environment =====
# Copy to .env and adjust. Never commit the real .env.

# Django
DJANGO_SECRET_KEY=change_me_to_a_long_random_string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost,http://localhost:5173,http://127.0.0.1

# ===== Baseline availability controls =====
# Disabled modules are omitted from the authenticated UI. Enable only after
# the module has been configured and accepted for the target deployment.
FEATURE_ANALYTICS=0
FEATURE_ACCESS_CONTROL=0
FEATURE_MAPS=0
FEATURE_FEDERATION=0
FEATURE_EVIDENCE=0

# Synthetic cameras, default credentials and random detector fixtures are
# development aids. Both switches default off and must never be enabled in a
# production installation.
SEED_DEMO_DATA=0
ENABLE_DEMO_ANALYTICS=0

# Camera credential encryption (apps.cameras.crypto). Leave EMPTY to derive a
# key from DJANGO_SECRET_KEY (fine for development). For production, generate a
# stable key once and keep it backed up — losing/changing it makes stored camera
# passwords unrecoverable:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# Database (Postgres)
POSTGRES_DB=persiansecure
POSTGRES_USER=persiansecure
POSTGRES_PASSWORD=persiansecure
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis (cache, channels, celery broker)
REDIS_URL=redis://redis:6379/0

# ===== Deployment mode =====
# The app serves live video through its own origin (nginx proxies /webrtc and
# /hls to MediaMTX), so the SAME build works in all three modes:
#
#   1) Local test      → open http://localhost:8080 ; leave PUBLIC_HOST empty
#   2) On-prem VMS     → PUBLIC_HOST=192.168.1.50   (the server's LAN IP)
#   3) Cloud VSaaS     → PUBLIC_HOST=vms.example.com (public domain or IP)
#
# PUBLIC_HOST is what MediaMTX advertises as its WebRTC (ICE) address. Without
# it, browsers on other machines can't receive the WebRTC media stream and will
# silently fall back to HLS (which always works, but with a few seconds delay).
PUBLIC_HOST=

# For clouds behind NAT you may also need a TURN server (leave blank if unsure;
# HLS fallback covers it). Format: turn:user:pass@host:3478
TURN_URL=

# MediaMTX (media server) — control API + playback endpoints
MEDIAMTX_API_URL=http://mediamtx:9997
# Leave these EMPTY to use same-origin relative paths (recommended, works
# everywhere). Only set absolute URLs for split/CDN deployments.
MEDIAMTX_HLS_URL=
MEDIAMTX_WEBRTC_URL=
MEDIAMTX_RTSP_HOST=mediamtx
MEDIAMTX_RTSP_PORT=8554
# Path where MediaMTX writes recording segments (shared volume)
RECORDINGS_DIR=/recordings
# Recording policy tuning (Phase 2)
# Motion mode records a short rolling buffer (seconds per segment).
MOTION_BUFFER_SECONDS=6
# Low-storage alarm: raise a critical alarm below N GB free, a warning below the
# free ratio.
STORAGE_MIN_FREE_GB=5
STORAGE_WARN_FREE_RATIO=0.10

# First-run seed superuser
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=admin@persiansecure.local

# SMS / voice-call alarms (fire, smoke, tripwire, ...)
# console = log only (no account needed) | kavenegar (Iran) | twilio
SMS_PROVIDER=console
KAVENEGAR_API_KEY=
SMS_SENDER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Admin phone that receives seeded fire/smoke/tripwire SMS alarms
ALARM_PHONE=+989120000000

# Frontend build-time API base (used by nginx proxy in compose, so relative)
VITE_API_BASE=/api
VITE_WS_BASE=/ws
